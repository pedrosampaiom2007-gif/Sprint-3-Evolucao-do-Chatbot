# Copie este arquivo para `.env` e preencha. O `.env` esta no .gitignore —
# NUNCA comite chave de API (o enunciado penaliza exposicao de credencial).

GROQ_API_KEY=

# Fonte dos dados de tempo real do sistema (carregadores livres/ocupados, faturamento):
#   stub  -> dados fixos embutidos. Roda offline, e o modo usado nos evals. (default)
#   real  -> importa o motor do Sistema-charge-gridd e consulta o Postgres. Precisa de DATABASE_URL.
CHARGEGRID_FONTE=stub
DATABASE_URL=

# Modelo padrao do chain. Qualquer modelo de chat da conta Groq serve.
GROQ_MODEL=openai/gpt-oss-20b
